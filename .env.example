# Copy this file to .env and adjust. The app has zero dependencies,
# so load it with: node --env-file=.env server/server.js (Node 20.6+)
# On Render, set these under Environment instead.

# Port the server listens on (Render sets this automatically)
PORT=4000

# Where promises are stored (JSON file). Use a persistent disk path in production.
DB_FILE=./data/db.json
